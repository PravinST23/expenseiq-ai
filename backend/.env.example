# =====================================================
# Application
# =====================================================

APP_NAME=ExpenseIQ API
APP_VERSION=1.0.0
APP_DESCRIPTION=Enterprise AI Expense Management Platform

HOST=127.0.0.1
PORT=8000

DEBUG=True

# =====================================================
# PostgreSQL
# =====================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=expenseiq
POSTGRES_USER=expenseiq_user
POSTGRES_PASSWORD=change-me

# =====================================================
# Google Gemini AI (Google AI Studio - free tier)
# https://aistudio.google.com/app/apikey
# =====================================================

GEMINI_API_KEY=your-gemini-api-key

# =====================================================
# Groq Cloud (free tier)
# https://console.groq.com/keys
# =====================================================

GROQ_API_KEY=your-groq-api-key

# =====================================================
# Ollama (local, offline receipt processing)
# =====================================================

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llava

# =====================================================
# CORS - comma-separated frontend origins allowed to call this API
# =====================================================

CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173

# =====================================================
# JWT Authentication - generate a real secret for anything
# shared/deployed, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
